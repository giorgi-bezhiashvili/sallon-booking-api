@baseUrl = http://localhost:3000
@boundary = ----SalonBoundary123456

### 1. Create staff — no photos
POST {{baseUrl}}/staff
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="name"

Nino
--{{boundary}}
Content-Disposition: form-data; name="roles"

stylist,colorist
--{{boundary}}--

### 2. Create staff — one photo
POST {{baseUrl}}/staff
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="name"

Mariam
--{{boundary}}
Content-Disposition: form-data; name="roles"

barber
--{{boundary}}
Content-Disposition: form-data; name="photos"; filename="photo1.jpg"
Content-Type: image/jpeg

< ./test-files/photo1.jpg
--{{boundary}}--

### 3. Create staff — multiple photos
POST {{baseUrl}}/staff
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="name"

Levan
--{{boundary}}
Content-Disposition: form-data; name="roles"

stylist
--{{boundary}}
Content-Disposition: form-data; name="photos"; filename="photo1.jpg"
Content-Type: image/jpeg

< ./test-files/photo1.jpg
--{{boundary}}
Content-Disposition: form-data; name="photos"; filename="photo2.png"
Content-Type: image/png

< ./test-files/photo2.png
--{{boundary}}--

### 4. Create staff — non-image file (now accepted, no type checking)
POST {{baseUrl}}/staff
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="name"

AnyFileTest
--{{boundary}}
Content-Disposition: form-data; name="roles"

stylist
--{{boundary}}
Content-Disposition: form-data; name="photos"; filename="notes.txt"
Content-Type: text/plain

< ./test-files/notes.txt
--{{boundary}}--

